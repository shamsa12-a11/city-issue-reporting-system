# Copy to .env (optional). Nothing here is secret: Vite puts VITE_* values in
# the browser bundle.

# Development: where `npm run dev` proxies /api and /uploads to.
VITE_DEV_BACKEND_URL=http://localhost:5000

# Production build only: the backend origin when the frontend is served from
# another host (leave empty when the backend serves the same origin).
VITE_API_ORIGIN=
