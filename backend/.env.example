# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env (it is already in .gitignore).

NODE_ENV=development
PORT=5000

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Do NOT add "?sslmode=..." here; SSL is controlled by DB_SSL below.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# SSL is required for Supabase. Set to false only for a local PostgreSQL.
DB_SSL=true
# Optional: path to the Supabase CA certificate (Database settings -> SSL)
# to fully verify the server certificate.
DB_SSL_CA_PATH=
DB_POOL_MAX=10

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Allowed frontend origin(s), comma-separated.
CORS_ORIGIN=http://localhost:5173

# Optional: folder for uploaded photos. Default: backend/uploads
# Relative paths are relative to the backend/ folder. A drive root (C:\ or /)
# is rejected at startup.
UPLOADS_DIR=

# Rate limiting (per IP, per window). Window is in milliseconds (15 min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
